<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//OrderWidget/t[@t-set-slot='details']/button[hasclass('book-table')]" position="replace"/>
    </t>

    <t t-inherit="point_of_sale.OrderlineCustomerNoteButton" t-inherit-mode="extension">
        <xpath expr="//button[@class='control-button btn btn-light rounded-0 fw-bolder']" position="replace"/>
    </t>

    <t t-inherit="pos_sale.SetSaleOrderButton" t-inherit-mode="extension">
        <xpath expr="//div[@class='control-button o_sale_order_button btn btn-light rounded-0 fw-bolder']" position="replace"/>
    </t>

    <t t-inherit="pos_restaurant.OrderlineNoteButton" t-inherit-mode="extension">
        <xpath expr="//button[@class='control-button btn btn-light rounded-0 fw-bolder']" position="replace"/>
    </t>

    <t t-inherit="pos_restaurant.TransferOrderButton" t-inherit-mode="extension">
         <xpath expr="//button[@class='control-button btn btn-light rounded-0 fw-bolder']" position="replace"/>
    </t>

    <t t-inherit="pos_restaurant.SplitBillButton" t-inherit-mode="extension">
        <xpath expr="//span[@class='control-button order-split btn btn-light rounded-0 fw-bolder']" position="replace"/>
    </t>

</templates>